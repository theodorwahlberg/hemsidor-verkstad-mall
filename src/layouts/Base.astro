---
import "../styles/global.css";
import { site } from "../site.config";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.name + " – " + site.tagline,
  description = site.tagline,
  ogImage = "/og.png",
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const ogImageAbs = Astro.site
  ? new URL(ogImage, Astro.site).href
  : ogImage;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Lottie web-component för animerade illustrationer */}
    <script
      src="https://unpkg.com/@lottiefiles/dotlottie-wc@latest/dist/dotlottie-wc.js"
      type="module"></script>
    <title>{title}</title>

    {/* Theme + JS-flag init — körs INNAN render för att undvika FOUC/FOWT */}
    <script is:inline>
      (function () {
        // JS-flag aktiverar reveal-animationer (graceful fallback utan JS)
        document.documentElement.classList.add("js");
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {
          /* localStorage kan vara blockerat — kör default */
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-shop text-paper">
    <a
      href="#huvudinnehall"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-warn focus:text-shop focus:px-4 focus:py-2 focus:font-semibold focus:font-mono focus:uppercase focus:text-xs focus:tracking-wider"
    >
      Hoppa till huvudinnehåll
    </a>
    <Nav />
    <main id="huvudinnehall" class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* ============ SCROLL- OCH ENTRY-ANIMATIONER ============ */}
    <script is:inline>
      (function () {
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (prefersReduced) return;

        // 1. REVEAL — fade-in + slide-up när element scrollas in
        const revealEls = document.querySelectorAll("[data-reveal]");
        if (revealEls.length && "IntersectionObserver" in window) {
          const revealIO = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  revealIO.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -80px 0px", threshold: 0.1 }
          );
          revealEls.forEach((el) => revealIO.observe(el));
        }

        // 2. COUNT-UP — räkna upp stat-numbers från 0 till slutvärdet
        const countEls = document.querySelectorAll("[data-count-target]");
        if (countEls.length && "IntersectionObserver" in window) {
          const countIO = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = el.getAttribute("data-count-target");
                const numTarget = parseFloat(target.replace(",", "."));
                if (isNaN(numTarget)) return;

                const decimals = target.includes(".") ? 1 : 0;
                const duration = 1400; // ms
                const start = performance.now();
                el.textContent = decimals ? "0.0" : "0";

                function step(now) {
                  const elapsed = now - start;
                  const t = Math.min(elapsed / duration, 1);
                  // ease-out cubic
                  const eased = 1 - Math.pow(1 - t, 3);
                  const value = numTarget * eased;
                  el.textContent = decimals
                    ? value.toFixed(1).replace(".", ",")
                    : Math.round(value).toString();
                  if (t < 1) requestAnimationFrame(step);
                  else el.textContent = target;
                }
                requestAnimationFrame(step);
                countIO.unobserve(el);
              });
            },
            { threshold: 0.4 }
          );
          countEls.forEach((el) => countIO.observe(el));
        }

        // 3. PARALLAX — bilen rör sig långsammare än övrig content vid scroll
        const parallaxEls = document.querySelectorAll(".car-parallax");
        if (parallaxEls.length) {
          let ticking = false;
          function updateParallax() {
            const scrollY = window.scrollY;
            parallaxEls.forEach((el) => {
              const speed = parseFloat(el.getAttribute("data-parallax-speed") || "0.3");
              const rect = el.getBoundingClientRect();
              const elTop = rect.top + scrollY;
              // Bara aktivera när elementet är i närheten av viewport
              const offset = (scrollY - elTop + window.innerHeight) * speed;
              el.style.setProperty("--parallax", offset * -0.15 + "px");
            });
            ticking = false;
          }
          window.addEventListener(
            "scroll",
            () => {
              if (!ticking) {
                requestAnimationFrame(updateParallax);
                ticking = true;
              }
            },
            { passive: true }
          );
          updateParallax();
        }

        // 4. SPIN-UP — hjul roterar snabbare när användaren scrollar aktivt
        const carEls = document.querySelectorAll("[data-car]");
        if (carEls.length) {
          let scrollTimeout;
          window.addEventListener(
            "scroll",
            () => {
              carEls.forEach((el) => el.classList.add("car-scrolling"));
              clearTimeout(scrollTimeout);
              scrollTimeout = setTimeout(() => {
                carEls.forEach((el) => el.classList.remove("car-scrolling"));
              }, 150);
            },
            { passive: true }
          );
        }
      })();
    </script>
  </body>
</html>
