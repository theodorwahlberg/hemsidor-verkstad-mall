---
import Base from "../layouts/Base.astro";
import Decor from "../components/Decor.astro";
import { site, projects } from "../site.config";
---

<Base title={`Vårt arbete – ${site.name}`}>
  <section class="border-b border-shop-line">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-dim">
        / Vårt arbete
      </p>
      <h1 class="font-display text-7xl md:text-[10rem] uppercase text-paper mt-3 leading-[0.85] tracking-tight">
        Tidigare<br />
        <span class="text-warn">jobb.</span>
      </h1>
      <p class="text-paper-dim mt-8 max-w-xl leading-relaxed">
        Ett urval av reparationer och servicar vi gjort de senaste åren. Vi
        arbetar med alla bilmärken — fråga oss om er specifika modell.
      </p>
    </div>
  </section>

  <section class="border-b border-shop-line">
    <div class="max-w-7xl mx-auto px-6 py-0">
      <table class="w-full">
        <thead class="border-b border-shop-line">
          <tr class="font-mono text-xs uppercase tracking-[0.2em] text-paper-soft">
            <th class="py-4 pr-4 text-left w-12">/</th>
            <th class="py-4 pr-4 text-left">Projekt</th>
            <th class="py-4 pr-4 text-left hidden md:table-cell">Kategori</th>
            <th class="py-4 pr-4 text-right tabular-nums">År</th>
          </tr>
        </thead>
        <tbody>
          {
            projects.map((p) => (
              <tr class="border-b border-shop-line hover:bg-shop-soft transition-colors group">
                <td class="py-8 pr-4 align-top">
                  <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-soft">
                    {p.no}
                  </p>
                </td>
                <td class="py-8 pr-4 align-top">
                  <h3 class="font-display text-3xl md:text-4xl uppercase text-paper tracking-tight leading-none group-hover:text-warn transition-colors">
                    {p.title}
                  </h3>
                  <p class="text-sm text-paper-dim mt-3 leading-relaxed max-w-2xl">
                    {p.description}
                  </p>
                </td>
                <td class="py-8 pr-4 align-top hidden md:table-cell">
                  <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper">
                    {p.category}
                  </p>
                </td>
                <td class="py-8 pr-4 align-top text-right">
                  <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-soft tabular-nums">
                    {p.year}
                  </p>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="border-b border-shop-line">
    <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 grid md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7">
        <div class="w-16 h-16 text-warn mb-8">
          <Decor variant="gear" />
        </div>
        <h2 class="font-display text-6xl md:text-8xl uppercase text-paper leading-[0.9] tracking-tight">
          Vill ni att vi tittar på <span class="text-warn">er bil?</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="text-paper-dim leading-relaxed">
          Skicka en offertförfrågan så återkopplar vi inom 24 timmar med pris
          och tid.
        </p>
        <a
          href="/offert"
          class="mt-6 inline-flex items-center justify-between bg-warn text-shop px-6 py-4 font-mono text-xs uppercase tracking-[0.2em] font-semibold hover:bg-warn-deep transition-colors w-full"
        >
          Begär offert <span>▸</span>
        </a>
      </div>
    </div>
  </section>
</Base>
