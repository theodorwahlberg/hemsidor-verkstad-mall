---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Decor from "../components/Decor.astro";
import { site, services, stats, reviews } from "../site.config";

const featured = services.slice(0, 6);
const todayName = new Date().toLocaleDateString("sv-SE", { weekday: "long" });
const todayCap = todayName.charAt(0).toUpperCase() + todayName.slice(1);
const todayHours = site.hours.find(
  (h) => h.day.toLowerCase() === todayName.toLowerCase(),
)?.time ?? "Stängt";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["AutoRepair", "LocalBusiness"],
  name: site.name,
  description: site.tagline,
  url: "https://sollentunabilservice.se",
  email: site.email,
  telephone: site.phone,
  priceRange: "595–3 500 kr",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postal,
    addressLocality: site.city,
    addressCountry: "SE",
  },
};
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <!-- ============ HERO ============ -->
  <section class="relative border-b border-shop-line overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 pt-12 pb-20 md:pt-20 md:pb-28">
      <!-- Top meta-row -->
      <div class="grid md:grid-cols-3 gap-4 font-mono text-xs uppercase tracking-[0.2em] text-paper-soft border-b border-shop-line pb-6 mb-12 md:mb-16">
        <p>
          <span class="text-paper-dim">Industry</span>
          <span class="text-paper ml-3">/ Bilverkstad</span>
        </p>
        <p>
          <span class="text-paper-dim">Etablerad</span>
          <span class="text-paper ml-3">/ {site.yearStarted}</span>
        </p>
        <p>
          <span class="text-paper-dim">Idag</span>
          <span class="text-warn ml-3">/ {todayCap} {todayHours}</span>
        </p>
      </div>

      <!-- Main display -->
      <div class="grid md:grid-cols-12 gap-8 items-end">
        <div class="md:col-span-8">
          <h1 class="font-display text-[20vw] md:text-[12rem] leading-[0.85] tracking-tight text-paper uppercase">
            Service<br />
            <span class="text-warn">utan</span><br />
            strul.
          </h1>
        </div>
        <div class="md:col-span-4 md:pb-8">
          <p class="text-paper-dim leading-relaxed">
            Familjedriven verkstad i {site.city}. Vi ger raka besked, fast pris
            och bilen tillbaka när vi sagt.
          </p>
          <div class="mt-8 flex flex-col gap-3">
            <a
              href="/offert"
              class="inline-flex items-center justify-between bg-warn text-shop px-6 py-4 font-mono text-xs uppercase tracking-[0.2em] font-semibold hover:bg-warn-deep transition-colors"
            >
              Begär offert
              <span>▸</span>
            </a>
            <a
              href={`tel:${site.phone.replace(/\s/g, "")}`}
              class="inline-flex items-center justify-between border border-paper/30 text-paper px-6 py-4 font-mono text-xs uppercase tracking-[0.2em] hover:bg-paper/5 transition-colors"
            >
              {site.phone}
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STAT-BAND ============ -->
  <section class="border-b border-shop-line">
    <div class="max-w-7xl mx-auto px-6 py-12 md:py-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4">
        {
          stats.map((stat, i) => (
            <div class:list={[
              "relative",
              i > 0 && "md:pl-8 md:border-l md:border-shop-line",
            ]}>
              <p class="font-display text-7xl md:text-8xl text-paper leading-none tabular-nums">
                {stat.value}<span class="text-warn">{stat.suffix}</span>
              </p>
              <p class="mt-3 font-mono text-xs uppercase tracking-[0.2em] text-paper-dim">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TJÄNSTER GRID ============ -->
  <section class="border-b border-shop-line">
    <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
      <div class="flex items-end justify-between flex-wrap gap-6 border-b border-shop-line pb-8 mb-12">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-dim">
            / Sektion 01
          </p>
          <h2 class="font-display text-6xl md:text-7xl uppercase text-paper mt-3 leading-none tracking-tight">
            Våra tjänster
          </h2>
        </div>
        <a
          href="/tjanster"
          class="font-mono text-xs uppercase tracking-[0.2em] text-warn hover:text-paper transition-colors"
        >
          Alla tjänster &amp; priser ▸
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-shop-line">
        {
          featured.map((s) => (
            <div class="bg-shop p-8 group hover:bg-shop-soft transition-colors">
              <div class="flex items-start justify-between mb-8">
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-soft">
                  / {s.no}
                </p>
                <div class="w-10 h-10 text-warn">
                  <Decor variant={s.icon} />
                </div>
              </div>
              <h3 class="font-display text-3xl uppercase text-paper tracking-tight leading-none">
                {s.name}
              </h3>
              <p class="text-sm text-paper-dim mt-4 leading-relaxed">
                {s.short}
              </p>
              <div class="mt-8 flex items-baseline justify-between border-t border-shop-line pt-4">
                <p class="font-mono text-xs uppercase tracking-[0.15em] text-paper-soft">
                  {s.duration}
                </p>
                <p class="font-display text-2xl text-warn tabular-nums">
                  {s.price}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  <section class="border-b border-shop-line bg-shop-soft">
    <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
      <div class="border-b border-shop-line pb-8 mb-12">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-dim">
          / Sektion 02
        </p>
        <h2 class="font-display text-6xl md:text-7xl uppercase text-paper mt-3 leading-none tracking-tight">
          Vad kunderna säger
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          reviews.map((r) => (
            <article class="border border-shop-line p-8 bg-shop">
              <p class="font-mono text-warn tracking-widest text-lg">
                {"★".repeat(r.rating)}
              </p>
              <p class="text-paper mt-6 leading-relaxed text-lg">
                "{r.text}"
              </p>
              <div class="mt-8 pt-4 border-t border-shop-line flex items-end justify-between">
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.15em] text-paper">
                    {r.customer}
                  </p>
                  <p class="font-mono text-xs uppercase tracking-[0.15em] text-paper-soft mt-1">
                    {r.car}
                  </p>
                </div>
                <p class="font-mono text-xs uppercase tracking-[0.15em] text-paper-soft tabular-nums">
                  {r.date}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="border-b border-shop-line">
    <div class="max-w-7xl mx-auto px-6 py-24 md:py-32">
      <div class="grid md:grid-cols-12 gap-8 items-end">
        <div class="md:col-span-7">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper-dim">
            / Sektion 03
          </p>
          <h2 class="font-display text-6xl md:text-8xl uppercase text-paper mt-3 leading-[0.9] tracking-tight">
            Behöver<br />
            bilen <span class="text-warn">hjälp?</span>
          </h2>
        </div>
        <div class="md:col-span-5">
          <p class="text-paper-dim leading-relaxed">
            Skicka en offertförfrågan så hör vi av oss inom 24 timmar med pris
            och tid. Eller ring oss direkt, vi svarar oftast på första
            signalen.
          </p>
          <div class="mt-8 flex flex-col gap-3">
            <a
              href="/offert"
              class="inline-flex items-center justify-between bg-warn text-shop px-6 py-4 font-mono text-xs uppercase tracking-[0.2em] font-semibold hover:bg-warn-deep transition-colors"
            >
              Begär offert
              <span>▸</span>
            </a>
            <a
              href={`tel:${site.phone.replace(/\s/g, "")}`}
              class="inline-flex items-center justify-between border border-paper/30 text-paper px-6 py-4 font-mono text-xs uppercase tracking-[0.2em] hover:bg-paper/5 transition-colors"
            >
              {site.phone}
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
