---
// Service-ikoner och dekorelement för verkstad-mallen.
// Minimal linjekonst i industriell stil — bara stroke, ingen fyllning.

interface Props {
  variant:
    | "wrench"
    | "gear"
    | "tire"
    | "brake"
    | "battery"
    | "ac"
    | "oil"
    | "diagnostic"
    | "key"
    | "arrow"
    | "divider"
    | "car-detailed"
    | "car-hood";
  class?: string;
}
const { variant, class: className = "" } = Astro.props;
---

{variant === "wrench" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 14 18 a 8 8 0 0 1 14 -4 l -6 6 v 6 l 4 4 h 6 l 6 -6 a 8 8 0 0 1 -4 14" />
      <line x1="32" y1="38" x2="52" y2="58" />
      <line x1="36" y1="34" x2="56" y2="54" />
    </g>
  </svg>
)}

{variant === "gear" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 32 4 L 36 12 L 46 8 L 46 18 L 56 20 L 52 30 L 60 32 L 52 34 L 56 44 L 46 46 L 46 56 L 36 52 L 32 60 L 28 52 L 18 56 L 18 46 L 8 44 L 12 34 L 4 32 L 12 30 L 8 20 L 18 18 L 18 8 L 28 12 Z" />
      <circle cx="32" cy="32" r="8" />
    </g>
  </svg>
)}

{variant === "tire" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
      <circle cx="32" cy="32" r="26" />
      <circle cx="32" cy="32" r="10" />
      <line x1="32" y1="6" x2="32" y2="22" />
      <line x1="32" y1="42" x2="32" y2="58" />
      <line x1="6" y1="32" x2="22" y2="32" />
      <line x1="42" y1="32" x2="58" y2="32" />
    </g>
  </svg>
)}

{variant === "brake" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
      <circle cx="32" cy="32" r="22" />
      <circle cx="32" cy="32" r="14" />
      <circle cx="32" cy="32" r="3" />
      <line x1="32" y1="10" x2="32" y2="18" />
      <line x1="32" y1="46" x2="32" y2="54" />
      <line x1="10" y1="32" x2="18" y2="32" />
      <line x1="46" y1="32" x2="54" y2="32" />
    </g>
  </svg>
)}

{variant === "battery" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <rect x="8" y="20" width="48" height="32" />
      <rect x="16" y="14" width="10" height="6" />
      <rect x="38" y="14" width="10" height="6" />
      <line x1="21" y1="32" x2="21" y2="40" />
      <line x1="17" y1="36" x2="25" y2="36" />
      <line x1="39" y1="36" x2="47" y2="36" />
    </g>
  </svg>
)}

{variant === "ac" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <line x1="32" y1="8" x2="32" y2="56" />
      <line x1="8" y1="32" x2="56" y2="32" />
      <line x1="14" y1="14" x2="50" y2="50" />
      <line x1="50" y1="14" x2="14" y2="50" />
      <circle cx="32" cy="32" r="4" />
    </g>
  </svg>
)}

{variant === "oil" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 32 8 C 24 22 18 32 18 40 a 14 14 0 0 0 28 0 C 46 32 40 22 32 8 Z" />
      <path d="M 28 36 a 6 6 0 0 0 0 8" />
    </g>
  </svg>
)}

{variant === "diagnostic" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <rect x="8" y="12" width="48" height="32" />
      <line x1="12" y1="44" x2="12" y2="52" />
      <line x1="52" y1="44" x2="52" y2="52" />
      <line x1="12" y1="52" x2="52" y2="52" />
      <polyline points="14,32 22,32 26,22 32,40 36,28 42,32 50,32" />
    </g>
  </svg>
)}

{variant === "key" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <circle cx="20" cy="32" r="10" />
      <line x1="30" y1="32" x2="56" y2="32" />
      <line x1="44" y1="32" x2="44" y2="40" />
      <line x1="52" y1="32" x2="52" y2="42" />
    </g>
  </svg>
)}

{variant === "arrow" && (
  <svg viewBox="0 0 64 16" class:list={["w-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
      <line x1="2" y1="8" x2="60" y2="8" />
      <polyline points="52,2 60,8 52,14" />
    </g>
  </svg>
)}

{variant === "divider" && (
  <svg viewBox="0 0 200 4" class:list={["w-full", className]} preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="2" x2="200" y2="2" stroke="currentColor" stroke-width="1" stroke-dasharray="6 4" />
  </svg>
)}

{variant === "car-detailed" && (
  <svg viewBox="0 0 680 280" xmlns="http://www.w3.org/2000/svg" class:list={["w-full", className]} aria-label="Klassisk sedan från sidan">
    {/* Skugga under bilen */}
    <ellipse cx="340" cy="240" rx="290" ry="10" fill="currentColor" opacity="0.15" />

    {/* Kaross — fylld huvudform med subtil opacitet */}
    <path
      d="M 40 195
         L 40 175
         Q 40 165 50 162
         L 70 158
         Q 80 156 90 145
         L 130 110
         Q 145 100 165 95
         L 240 88
         Q 280 85 320 86
         L 410 90
         Q 460 96 500 122
         L 540 152
         Q 555 160 575 162
         L 615 168
         Q 635 172 638 184
         L 638 195
         Z"
      fill="currentColor"
      opacity="0.92"
    />

    {/* Fönster — vindruta */}
    <path
      d="M 165 100
         Q 170 96 180 95
         L 295 90
         L 312 132
         L 175 132
         Q 168 132 166 126
         Z"
      fill="currentColor"
      opacity="0.4"
    />
    {/* Fönster — bakruta */}
    <path
      d="M 312 90
         L 405 95
         Q 430 98 450 115
         L 480 132
         L 320 132
         Z"
      fill="currentColor"
      opacity="0.4"
    />

    {/* B-pelare mellan fönstren */}
    <rect x="307" y="92" width="8" height="42" fill="currentColor" opacity="0.92" />

    {/* Karosslinje (lower belt) */}
    <line
      x1="80"
      y1="165"
      x2="615"
      y2="170"
      stroke="currentColor"
      stroke-width="1.5"
      opacity="0.5"
    />

    {/* Dörrlinjer */}
    <line x1="180" y1="135" x2="180" y2="190" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
    <line x1="310" y1="135" x2="310" y2="190" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
    <line x1="450" y1="135" x2="450" y2="190" stroke="currentColor" stroke-width="1.2" opacity="0.4" />

    {/* Dörrhandtag */}
    <rect x="230" y="148" width="22" height="4" rx="2" fill="currentColor" opacity="0.55" />
    <rect x="370" y="148" width="22" height="4" rx="2" fill="currentColor" opacity="0.55" />

    {/* Sidoback-spegel */}
    <path
      d="M 158 110 L 152 102 L 160 100 L 165 108 Z"
      fill="currentColor"
      opacity="0.92"
    />

    {/* Framlykta */}
    <ellipse cx="56" cy="175" rx="14" ry="7" fill="currentColor" opacity="0.5" />
    <ellipse cx="56" cy="174" rx="9" ry="4" fill="currentColor" opacity="0.85" />

    {/* Grill — vertikala stickor */}
    <line x1="60" y1="184" x2="60" y2="195" stroke="currentColor" stroke-width="1.5" opacity="0.45" />
    <line x1="66" y1="184" x2="66" y2="195" stroke="currentColor" stroke-width="1.5" opacity="0.45" />
    <line x1="72" y1="184" x2="72" y2="195" stroke="currentColor" stroke-width="1.5" opacity="0.45" />
    <line x1="78" y1="184" x2="78" y2="195" stroke="currentColor" stroke-width="1.5" opacity="0.45" />

    {/* Baklykta */}
    <rect x="608" y="170" width="24" height="14" rx="2" fill="currentColor" opacity="0.5" />
    <rect x="612" y="172" width="16" height="10" rx="1" fill="currentColor" opacity="0.85" />

    {/* Avgasrör */}
    <rect x="618" y="200" width="20" height="6" rx="2" fill="currentColor" opacity="0.45" />

    {/* Hjul fram — med spin-klass */}
    <g class="wheel-front">
      <circle cx="160" cy="200" r="42" fill="currentColor" opacity="0.92" />
      <circle cx="160" cy="200" r="30" fill="currentColor" opacity="0.5" />
      <circle cx="160" cy="200" r="22" fill="currentColor" opacity="0.92" />
      <g class="wheel-spokes" style="transform-origin: 160px 200px;">
        <circle cx="160" cy="200" r="6" fill="currentColor" opacity="0.4" />
        <rect x="158" y="178" width="4" height="44" fill="currentColor" opacity="0.4" />
        <rect x="138" y="198" width="44" height="4" fill="currentColor" opacity="0.4" />
        <g transform="rotate(45 160 200)">
          <rect x="158" y="178" width="4" height="44" fill="currentColor" opacity="0.4" />
          <rect x="138" y="198" width="44" height="4" fill="currentColor" opacity="0.4" />
        </g>
      </g>
    </g>

    {/* Hjul bak */}
    <g class="wheel-rear">
      <circle cx="510" cy="200" r="42" fill="currentColor" opacity="0.92" />
      <circle cx="510" cy="200" r="30" fill="currentColor" opacity="0.5" />
      <circle cx="510" cy="200" r="22" fill="currentColor" opacity="0.92" />
      <g class="wheel-spokes" style="transform-origin: 510px 200px;">
        <circle cx="510" cy="200" r="6" fill="currentColor" opacity="0.4" />
        <rect x="508" y="178" width="4" height="44" fill="currentColor" opacity="0.4" />
        <rect x="488" y="198" width="44" height="4" fill="currentColor" opacity="0.4" />
        <g transform="rotate(45 510 200)">
          <rect x="508" y="178" width="4" height="44" fill="currentColor" opacity="0.4" />
          <rect x="488" y="198" width="44" height="4" fill="currentColor" opacity="0.4" />
        </g>
      </g>
    </g>
  </svg>
)}

{variant === "car-hood" && (
  <svg viewBox="0 0 600 220" xmlns="http://www.w3.org/2000/svg" class:list={["w-full", className]} aria-label="Bil med öppen motorhuv">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M 30 170 L 540 170" />
      <path d="M 30 170 L 30 145 L 540 145 L 540 170" />
      {/* Öppen motorhuv vinklad uppåt */}
      <g class="hood-lift">
        <path d="M 70 138 L 200 60" />
        <line x1="70" y1="138" x2="70" y2="145" stroke-width="1" opacity="0.5" />
      </g>
      {/* Motor innanför */}
      <rect x="75" y="120" width="120" height="18" stroke-dasharray="2 3" opacity="0.5" />
      {/* Hjul */}
      <circle cx="100" cy="170" r="20" />
      <circle cx="100" cy="170" r="8" />
      <circle cx="450" cy="170" r="20" />
      <circle cx="450" cy="170" r="8" />
    </g>
  </svg>
)}
