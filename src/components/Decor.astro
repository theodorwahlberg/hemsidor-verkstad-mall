---
// Service-ikoner och dekorelement för verkstad-mallen.
// Minimal linjekonst i industriell stil — bara stroke, ingen fyllning.

interface Props {
  variant:
    | "wrench"
    | "gear"
    | "tire"
    | "brake"
    | "battery"
    | "ac"
    | "oil"
    | "diagnostic"
    | "key"
    | "arrow"
    | "divider";
  class?: string;
}
const { variant, class: className = "" } = Astro.props;
---

{variant === "wrench" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 14 18 a 8 8 0 0 1 14 -4 l -6 6 v 6 l 4 4 h 6 l 6 -6 a 8 8 0 0 1 -4 14" />
      <line x1="32" y1="38" x2="52" y2="58" />
      <line x1="36" y1="34" x2="56" y2="54" />
    </g>
  </svg>
)}

{variant === "gear" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 32 4 L 36 12 L 46 8 L 46 18 L 56 20 L 52 30 L 60 32 L 52 34 L 56 44 L 46 46 L 46 56 L 36 52 L 32 60 L 28 52 L 18 56 L 18 46 L 8 44 L 12 34 L 4 32 L 12 30 L 8 20 L 18 18 L 18 8 L 28 12 Z" />
      <circle cx="32" cy="32" r="8" />
    </g>
  </svg>
)}

{variant === "tire" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
      <circle cx="32" cy="32" r="26" />
      <circle cx="32" cy="32" r="10" />
      <line x1="32" y1="6" x2="32" y2="22" />
      <line x1="32" y1="42" x2="32" y2="58" />
      <line x1="6" y1="32" x2="22" y2="32" />
      <line x1="42" y1="32" x2="58" y2="32" />
    </g>
  </svg>
)}

{variant === "brake" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
      <circle cx="32" cy="32" r="22" />
      <circle cx="32" cy="32" r="14" />
      <circle cx="32" cy="32" r="3" />
      <line x1="32" y1="10" x2="32" y2="18" />
      <line x1="32" y1="46" x2="32" y2="54" />
      <line x1="10" y1="32" x2="18" y2="32" />
      <line x1="46" y1="32" x2="54" y2="32" />
    </g>
  </svg>
)}

{variant === "battery" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <rect x="8" y="20" width="48" height="32" />
      <rect x="16" y="14" width="10" height="6" />
      <rect x="38" y="14" width="10" height="6" />
      <line x1="21" y1="32" x2="21" y2="40" />
      <line x1="17" y1="36" x2="25" y2="36" />
      <line x1="39" y1="36" x2="47" y2="36" />
    </g>
  </svg>
)}

{variant === "ac" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <line x1="32" y1="8" x2="32" y2="56" />
      <line x1="8" y1="32" x2="56" y2="32" />
      <line x1="14" y1="14" x2="50" y2="50" />
      <line x1="50" y1="14" x2="14" y2="50" />
      <circle cx="32" cy="32" r="4" />
    </g>
  </svg>
)}

{variant === "oil" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <path d="M 32 8 C 24 22 18 32 18 40 a 14 14 0 0 0 28 0 C 46 32 40 22 32 8 Z" />
      <path d="M 28 36 a 6 6 0 0 0 0 8" />
    </g>
  </svg>
)}

{variant === "diagnostic" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <rect x="8" y="12" width="48" height="32" />
      <line x1="12" y1="44" x2="12" y2="52" />
      <line x1="52" y1="44" x2="52" y2="52" />
      <line x1="12" y1="52" x2="52" y2="52" />
      <polyline points="14,32 22,32 26,22 32,40 36,28 42,32 50,32" />
    </g>
  </svg>
)}

{variant === "key" && (
  <svg viewBox="0 0 64 64" class:list={["w-full h-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
      <circle cx="20" cy="32" r="10" />
      <line x1="30" y1="32" x2="56" y2="32" />
      <line x1="44" y1="32" x2="44" y2="40" />
      <line x1="52" y1="32" x2="52" y2="42" />
    </g>
  </svg>
)}

{variant === "arrow" && (
  <svg viewBox="0 0 64 16" class:list={["w-full", className]} aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
      <line x1="2" y1="8" x2="60" y2="8" />
      <polyline points="52,2 60,8 52,14" />
    </g>
  </svg>
)}

{variant === "divider" && (
  <svg viewBox="0 0 200 4" class:list={["w-full", className]} preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="2" x2="200" y2="2" stroke="currentColor" stroke-width="1" stroke-dasharray="6 4" />
  </svg>
)}
